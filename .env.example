# Match the browser origin/port; the local manual MVP uses 8005.
ALLOWED_ORIGINS=http://localhost:8005,http://127.0.0.1:8005
DATA_DIR=runtime
OCR_TIMEOUT=90
TTL_SECONDS=86400
GLOBAL_JOB_BUDGET=200
# NODE_BINARY=node
# OCR_CACHE=/app/model-cache
# Local: pinned PP-OCRv5 mobile eslav (RU+EN), CPU only
OCR_CPU_THREADS=4
# LOCAL_OCR_CACHE=/app/model-cache/ppocrv5
# API mode only: server-side key; never put keys in frontend or screenshots
# GOOGLE_VISION_API_KEY=

# Text assistance: server-side only, disabled until a key and free-plan flag exist.
# Groq Free Plan. Do not enable paid billing for a zero-budget demo.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_GROQ_FREE_PLAN=1
LLM_DAILY_BUDGET=40
# Alternative, select explicitly (no automatic fallback):
# LLM_PROVIDER=openrouter
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# OpenRouter adapter refuses model IDs without :free. Its free endpoints
# may lack constrained JSON; every answer is validated on our server.
